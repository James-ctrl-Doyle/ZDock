// ZDock 版本资源。
// ⚠ 版本号的唯一来源就是这里：改版本要同时改下面四处 VERSIONINFO 字段
// （FILEVERSION / PRODUCTVERSION / FileVersion / ProductVersion）。
// VS_VERSION_INFO / VS_FFI_FILEFLAGSMASK 这些宏来自 winver.h，rc 不会自动带。
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,6,0
 PRODUCTVERSION 0,1,6,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "James-ctrl-Doyle"
            VALUE "FileDescription", "ZDock - Windows desktop dock"
            VALUE "FileVersion", "0.1.6.0"
            VALUE "InternalName", "ZDock"
            VALUE "LegalCopyright", "Copyright (C) 2026 James-ctrl-Doyle"
            VALUE "OriginalFilename", "ZDock.exe"
            VALUE "ProductName", "ZDock"
            VALUE "ProductVersion", "0.1.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
